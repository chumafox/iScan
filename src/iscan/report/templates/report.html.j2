<!DOCTYPE html>
<html lang="{{ lang }}" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark light">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
    <title>{{ r.device.commercial_name or r.device.product_type or s.title }} — iScan</title>
    <style>
        :root {
            --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --mono: "SF Mono", SFMono-Regular, ui-monospace, Monaco, Consolas, monospace;
            --bg: #f5f5f7;
            --panel: #fff;
            --text: #1d1d1f;
            --muted: #6e6e73;
            --border: #d2d2d7;
            --accent: #0071e3;
            --ok: #16803c;
            --warn: #b45309;
            --bad: #c62828;
            --hover: #f0f0f2;
        }
        html.dark {
            --bg: #090a0c;
            --panel: #151619;
            --text: #f5f5f7;
            --muted: #98989d;
            --border: #343438;
            --accent: #2997ff;
            --ok: #30d158;
            --warn: #ff9f0a;
            --bad: #ff453a;
            --hover: #1d1e22;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 3.5rem 1.25rem;
            background: var(--bg);
            color: var(--text);
            font: 15px/1.45 var(--font);
            -webkit-font-smoothing: antialiased;
        }
        .container { max-width: 760px; margin: 0 auto; }
        header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 2rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid var(--border);
        }
        h1 { margin: 0 0 .35rem; font-size: 1.55rem; font-weight: 650; letter-spacing: -.025em; }
        .header-meta { color: var(--muted); font: .77rem var(--mono); }
        .header-actions { display: flex; align-items: center; gap: .65rem; }
        .theme-toggle {
            width: 2.25rem; height: 2.25rem; border: 1px solid var(--border); border-radius: 999px;
            background: transparent; color: var(--text); cursor: pointer; display: grid; place-items: center;
        }
        .theme-toggle:hover { background: var(--hover); }
        html.dark .sun-icon, html:not(.dark) .moon-icon { display: block; }
        html.dark .moon-icon, html:not(.dark) .sun-icon { display: none; }
        .badge {
            display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .6rem;
            border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font-size: .74rem;
        }
        .section {
            margin: 0 0 1.15rem; overflow: hidden; border: 1px solid var(--border);
            border-radius: 12px; background: var(--panel);
        }
        .section-header {
            padding: .8rem 1.1rem .62rem; border-bottom: 1px solid var(--border);
            color: var(--muted); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
        }
        .row {
            display: flex; align-items: baseline; justify-content: space-between; gap: 1.25rem;
            min-height: 2.55rem; padding: .62rem 1.1rem; border-bottom: 1px solid var(--border);
        }
        .row:last-child { border-bottom: 0; }
        .row:hover { background: var(--hover); }
        .label { color: var(--text); flex: 0 0 auto; }
        .value {
            min-width: 0; color: var(--text); font: .79rem var(--mono); text-align: right;
            overflow-wrap: anywhere;
        }
        .muted-value { color: var(--muted); font-size: .75rem; }
        .status-icon { width: 14px; height: 14px; margin-left: .4rem; vertical-align: -2px; }
        .status-icon.normal { color: var(--ok); }
        .status-icon.warning { color: var(--warn); }
        .health { font-weight: 700; }
        .transport-grid { display: grid; grid-template-columns: 1fr 1fr; }
        .transport-grid .row { border-right: 1px solid var(--border); }
        .transport-grid .row:nth-child(2n) { border-right: 0; }
        .note-list { margin: 0; padding: .75rem 1.25rem 1rem 2.25rem; color: var(--muted); }
        .note-list li { padding: .2rem 0; }
        .collection-status { font: .74rem var(--mono); }
        .collection-status.ok { color: var(--ok); }
        .collection-status.warning, .collection-status.timeout { color: var(--warn); }
        .collection-status.error { color: var(--bad); }
        .collection-status.unavailable { color: var(--muted); }
        footer { margin: 2.5rem 0 1rem; color: var(--muted); text-align: center; font-size: .78rem; }
        @media (max-width: 560px) {
            body { padding: 2rem .75rem; }
            header { flex-direction: column; }
            .header-actions { width: 100%; justify-content: space-between; }
            .row { align-items: flex-start; padding: .65rem .8rem; gap: .75rem; }
            .value { font-size: .72rem; }
            .transport-grid { display: block; }
            .transport-grid .row { border-right: 0; }
        }
        @media print {
            body { padding: 0; background: #fff; color: #000; }
            .theme-toggle { display: none; }
            .section { break-inside: avoid; border-color: #bbb; }
        }
    </style>
</head>
<body>
{% macro render_status(kind) -%}
    {% if status.get(kind) == 'normal' %}
        <svg class="status-icon normal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-label="OK"><path d="m5 12 4 4L19 6"/></svg>
    {% elif status.get(kind) in ['warning', 'replaced'] %}
        <svg class="status-icon warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-label="Warning"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
    {% endif %}
{%- endmacro %}
{% macro value_or_na(value) -%}
    {%- if value is not none and value != '' -%}{{ value }}{%- else -%}{{ s.na }}{%- endif -%}
{%- endmacro %}
{% macro row(label, value, kind=None, muted=None, value_style=None) -%}
    <div class="row">
        <span class="label">{{ label }}</span>
        <span class="value{% if value_style %} {{ value_style }}{% endif %}"{% if value_style == 'health' %} style="color: {{ health_color }}"{% endif %}>
            {{ value_or_na(value) }}{% if muted %} <span class="muted-value">({{ muted }})</span>{% endif %}{{ render_status(kind) if kind else '' }}
        </span>
    </div>
{%- endmacro %}
<div class="container">
    <header>
        <div>
            <h1>{{ r.device.commercial_name or r.device.product_type or s.title }}</h1>
            <div class="header-meta">{{ s.generated }} {{ r.generated_at }} · {{ s.iscan_version }} {{ r.iscan_version }}</div>
        </div>
        <div class="header-actions">
            <span class="badge">{{ s.get(r.transport.kind, r.transport.kind) }}</span>
            <button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle theme">
                <svg class="sun-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                <svg class="moon-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.7 6.7 0 0 0 21 12.8Z"/></svg>
            </button>
        </div>
    </header>

    <section class="section">
        <div class="section-header">{{ s.device }}</div>
        {{ row(s.device_name, r.device.device_name) }}
        {{ row(s.commercial_model, r.device.commercial_name) }}
        {{ row(s.product_type, r.device.product_type) }}
        {{ row(s.device_color, r.device.device_color) }}
        {{ row(s.sales_model, r.device.sales_model) }}
        {{ row(s.model, r.device.regulatory_model) }}
        {{ row(s.ios_version, r.device.product_version, muted=r.device.build_version) }}
        {{ row(s.serial, r.device.serial_number, 'serial') }}
        {{ row(s.udid, r.device.udid, 'udid') }}
        {{ row(s.baseband, r.device.baseband_version) }}
        {{ row(s.sim_status, s.get(r.device.sim_status, r.device.sim_status), 'sim') }}
        {{ row(s.fmi_status, s.get(r.device.fmi_status, r.device.fmi_status), muted=r.device.apple_id) }}
        {{ row(s.activation_state, r.device.activation_state) }}
    </section>

    <section class="section">
        <div class="section-header">{{ s.battery }}</div>
        {% set charging = s.yes if r.battery.is_charging is true else (s.no if r.battery.is_charging is false else none) %}
        {{ row(s.health, (r.battery.health_percent|round(0, 'common') ~ '%') if r.battery.health_percent is not none else none, 'battery', value_style='health' if r.battery.health_percent is not none else none) }}
        {{ row(s.cycle_count, r.battery.cycle_count) }}
        {{ row(s.design_capacity, (r.battery.design_capacity|string ~ ' ' ~ s.mah) if r.battery.design_capacity is not none else none) }}
        {{ row(s.full_charge_capacity, (r.battery.full_charge_capacity|string ~ ' ' ~ s.mah) if r.battery.full_charge_capacity is not none else none, muted=s.bms_modified if status.get('battery_fcc') == 'warning' else none) }}
        {{ row(s.battery_serial, r.battery.battery_serial, muted=decoded.battery) }}
        {{ row(s.charging, charging) }}
    </section>

    <section class="section">
        <div class="section-header">{{ s.storage }}</div>
        {{ row(s.used, (storage.used ~ ' / ' ~ (storage.total or s.na) ~ (' (' ~ storage.used_percent ~ '%)' if storage.used_percent is not none else '')) if storage.used is not none else none) }}
        {{ row(s.available, storage.available) }}
    </section>

    <section class="section">
        <div class="section-header">{{ s.components }}</div>
        {{ row(s.mlb, r.components.mlb_serial, 'mlb') }}
        {{ row(s.wifi_board, r.components.wireless_board_serial, 'wifi') }}
        {{ row(s.ssd, r.components.ssd_serial, 'ssd') }}
        {{ row(s.display, r.components.display_serial, 'display', muted=decoded.display) }}
        {{ row(s.touch_screen, r.components.touch_serial, 'touch') }}
        {{ row(s.rear_camera, r.components.rear_camera_serial, 'rear_camera') }}
        {{ row(s.front_camera, r.components.front_camera_serial, 'front_camera') }}
        {{ row(s.biometric, r.components.biometric_serial, 'biometric', muted=decoded.biometric) }}
        {{ row(s.als, r.components.als_serial, 'als') }}
    </section>

    <section class="section">
        <div class="section-header">{{ s.identifiers }}</div>
        {{ row(s.imei, r.identifiers.imei) }}
        {{ row(s.imei2, r.identifiers.imei2) }}
        {{ row(s.ecid, r.identifiers.ecid) }}
        {{ row(s.wifi_mac, r.identifiers.wifi_mac) }}
        {{ row(s.bt_mac, r.identifiers.bt_mac) }}
        {{ row(s.meid, r.identifiers.meid) }}
    </section>

    <section class="section">
        <div class="section-header">{{ s.transport }}</div>
        <div class="transport-grid">
            {{ row(s.kind, s.get(r.transport.kind, r.transport.kind)) }}
            {{ row(s.source, r.transport.source) }}
            {{ row('Address', r.transport.address) }}
            {% if r.transport.networkusb_agent %}{{ row(s.remote_agent, r.transport.networkusb_agent) }}{% endif %}
            {% if r.transport.networkusb_fingerprint %}{{ row(s.fingerprint, r.transport.networkusb_fingerprint) }}{% endif %}
            {% if r.transport.networkusb_version %}{{ row(s.networkusb_version, r.transport.networkusb_version) }}{% endif %}
        </div>
    </section>

    <section class="section">
        <div class="section-header">{{ s.collection }}</div>
        {% for name, record in r.collection.items() %}
            <div class="row">
                <span class="label">{{ name|replace('_', ' ')|title }}</span>
                <span class="collection-status {{ record.status }}">{{ record.status }}{% if record.duration_ms is not none %} · {{ record.duration_ms }} ms{% endif %}</span>
            </div>
        {% endfor %}
    </section>

    {% if r.issues %}
    <section class="section">
        <div class="section-header">{{ s.issues }}</div>
        <ul class="note-list">
            {% for issue in r.issues %}<li><strong>{{ issue.collector }}</strong>: {{ issue.message }}</li>{% endfor %}
        </ul>
    </section>
    {% endif %}

    <footer>iScan · {{ r.iscan_version }} · {{ r.generated_at }}</footer>
</div>
<script>
    function toggleTheme() {
        document.documentElement.classList.toggle('dark');
        localStorage.setItem('iscan-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    }
    if (localStorage.getItem('iscan-theme') === 'light') document.documentElement.classList.remove('dark');
</script>
</body>
</html>
